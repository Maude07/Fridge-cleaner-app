<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.MaudeLebeau.fridgecleaner.ui.RecipeController"
      spacing="12"
      styleClass="card">

    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <Label text="Recettes" styleClass="headline"/>

    <TableView fx:id="recipesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameCol" text="Nom" prefWidth="480"/>
            <TableColumn fx:id="servingsCol" text="Portions" prefWidth="140"/>
            <TableColumn fx:id="actionsCol" prefWidth="90"/>
        </columns>
    </TableView>

</VBox>